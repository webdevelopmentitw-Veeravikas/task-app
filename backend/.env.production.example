# Production database. Copy to .env.production and set the real values there.
# Do not commit .env.production.
#
# Run the API directly:
#   PowerShell: $env:APP_ENV='production'; npm start
#   bash:       APP_ENV=production npm start
#
# Or start the production containers from the project root:
#   docker compose --env-file backend/.env.production -f docker-compose.prod.yml up -d

APP_ENV=production
PORT=3001
DB_HOST=your-production-db-host
DB_PORT=3306
DB_USER=taskuser
DB_PASSWORD=replace-with-production-password
DB_NAME=taskdb
# Set to true when the production server requires TLS.
DB_SSL=false
