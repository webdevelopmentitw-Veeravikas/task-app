# Copy to .env. Do not commit .env.
# APP_ENV=local uses the LOCAL_DB_* values.
# APP_ENV=live uses the LIVE_DB_* values.

APP_ENV=local
PORT=3001

LOCAL_DB_HOST=127.0.0.1
LOCAL_DB_PORT=3306
LOCAL_DB_USER=root
LOCAL_DB_PASSWORD=
LOCAL_DB_NAME=taskdb

LIVE_DB_HOST=your-live-db-host
LIVE_DB_PORT=3306
LIVE_DB_USER=taskuser
LIVE_DB_PASSWORD=replace-with-live-password
LIVE_DB_NAME=taskdb
LIVE_DB_SSL=false

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=taskdb
MYSQL_USER=taskuser
MYSQL_PASSWORD=change-me-app
